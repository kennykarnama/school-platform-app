# Image version. Keep latest for automatic stable upgrades, or pin 1.2.3 for rollback.
IMAGE_TAG=latest

# Existing CockroachDB databases. Preserve the TLS parameters from CockroachDB Cloud.
ADMIN_DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/school_administration?sslmode=verify-full
USER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/school_user?sslmode=verify-full

# Replace these with independent, randomly generated secrets.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

ADMIN_ENABLE_AUTH=true
ADMIN_SESSION_TTL=3600
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=168h

# false for direct HTTP access; true when the browser reaches the UI through HTTPS.
SESSION_COOKIE_SECURE=false
ENABLE_EMAIL_CONFIRMATION=false
DB_LOG_MODE=false

UI_PORT=3000
ADMIN_API_PORT=8081
USER_API_PORT=8082
