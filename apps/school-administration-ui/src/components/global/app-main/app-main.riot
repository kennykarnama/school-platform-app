 <app-main>
        <div class="container" style="margin-top: 2%; margin-left: 2%;">
            <div class="columns">
                <div class="col-2">
                    <aside-menu teacher={state.teacher}></aside-menu>
                </div>
                <div class="col-8">
                    <app-content></app-content>
                </div>
            </div>
        </div>
        <script>
            import AsideMenu from '../../includes/aside-menu/aside-menu.riot';
            import {router} from "@riotjs/route";

            export default {
                state: {
                    teacher: null,
                },
                components: {
                    AsideMenu,
                },
                onBeforeMount() {
                    // Production uses same-origin /api requests so HTTPS traffic is
                    // routed through Nginx. Local development supplies an explicit URL.
                    axios.defaults.baseURL = process.env.SCHOOL_ADMINISTRATION_API_BASE_URL || ''
                    axios.defaults.withCredentials = true
                    this.responseInterceptor = axios.interceptors.response.use(response => {
                        return response;
                    }, error => {
                        if (error.response && error.response.status === 401) {
                            router.push('/#login')
                        }
                        return Promise.reject(error)
                    });

                    this.teacherLoginHandler = () => this.loadTeacher()
                    window.addEventListener('school:teacher-authenticated', this.teacherLoginHandler)

                    if (window.location.hash !== '#login') {
                        this.loadTeacher()
                    }
                },
                onBeforeUnmount() {
                    window.removeEventListener('school:teacher-authenticated', this.teacherLoginHandler)
                    axios.interceptors.response.eject(this.responseInterceptor)
                },
                loadTeacher() {
                    axios.get(`/api/v1/teacher/session/validate`)
                        .then(res => {
                            this.update({
                                teacher: res.data,
                            })
                        }).catch(e => {
                            console.log(e)
                        });
                }
            }

        </script>
 </app-main>
